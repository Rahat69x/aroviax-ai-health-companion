# ==============================================================================
# Aroviax — Backend Environment Variables (.env.example)
#
# IMPORTANT:
# Keep this file template in git. Never commit real API keys or secrets.
# Copy this file to `backend/.env` for local development.
# ==============================================================================

# Server Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# AI Provider Configuration
# Set your server-side API key from OpenAI (https://platform.openai.com)
# or Google AI Studio (https://aistudio.google.com).
# If no key is set, Aroviax operates in deterministic clinical safety mode.
AI_API_KEY=your_server_side_api_key_here
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
AI_TIMEOUT_SECONDS=8.0
