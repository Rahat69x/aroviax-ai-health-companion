# Aroviax - Environment Configuration
# Optional external AI providers.
# If no API keys are provided, Aroviax operates seamlessly in 100%
# deterministic, private, non-diagnostic local mode with zero external network calls.

# Google Gemini API Key (optional)
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional)
# OPENAI_API_KEY=your_openai_api_key_here

# Python FastAPI AI Backend URL (optional, defaults to http://127.0.0.1:8000 when active)
# PYTHON_BACKEND_URL=http://localhost:8000

